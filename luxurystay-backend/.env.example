# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/luxurystay
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/luxurystay
MONGODB_URI=mongodb://localhost:27017/luxurystay

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Use * for development, restrict to your frontend origin in production
CORS_ORIGIN=http://localhost:3000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─── AI Booking Assistant (Google Gemini) ─────────────────────────────────────
# Create a free key at https://aistudio.google.com/apikey — never commit it
GEMINI_API_KEY=
# Tried in order, then a second pass, when a model is busy
GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ─── AI fallback provider (Groq, free) ────────────────────────────────────────
# Create a key at https://console.groq.com/keys — never commit it
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# Provider order for the AI assistant; each configured provider is tried in turn
LLM_PROVIDERS=groq,gemini
